GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Cisco IOS XE sandbox credentials (read-only RESTCONF via app.cisco adapter).
# Provided by the DevNet sandbox portal; never commit real values.
CISCO_SANDBOX_HOST=
CISCO_SANDBOX_USERNAME=
CISCO_SANDBOX_PASSWORD=
CISCO_SANDBOX_INTERFACE=
CISCO_SANDBOX_VERIFY_TLS=false

# Collection freshness threshold in seconds for GET /telemetry/latest.
# Positive values only; missing or invalid values fall back to 300 seconds.
NETOPS_STALE_THRESHOLD_SECONDS=300

# Maximum time for one /analyze agent request, in seconds.
# Positive values only; missing or invalid values fall back to 60 seconds.
NETOPS_AGENT_TIMEOUT_SECONDS=60
